<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- #55/#57: shared container with the app (same group id as the app's
	     entitlements). Required on device; the simulator runs unsigned. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.noshu.shadygaragespeed</string>
	</array>
</dict>
</plist>
